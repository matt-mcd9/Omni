<UserControl x:Class="Omni.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ChannelLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ChannelSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- RGB sliders + hex box; raises ColorChanged when the user edits either -->
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="R" Style="{StaticResource ChannelLabelStyle}"/>
            <Slider x:Name="RSlider" Style="{StaticResource ChannelSliderStyle}" ValueChanged="Channel_ValueChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="G" Style="{StaticResource ChannelLabelStyle}"/>
            <Slider x:Name="GSlider" Style="{StaticResource ChannelSliderStyle}" ValueChanged="Channel_ValueChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="B" Style="{StaticResource ChannelLabelStyle}"/>
            <Slider x:Name="BSlider" Style="{StaticResource ChannelSliderStyle}" ValueChanged="Channel_ValueChanged"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Hex" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="HexBox" Width="100" Padding="6,4" MaxLength="7"
                     FontFamily="Consolas"
                     Background="{DynamicResource BgBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
        </StackPanel>
    </StackPanel>
</UserControl>
