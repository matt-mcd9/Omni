<UserControl x:Class="Omni.Controls.MiniPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Unloaded="MiniPlayer_Unloaded">
    <UserControl.Resources>
        <!-- Round icon button for the controls; Content is a glyph -->
        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin track pieces for ThinSliderStyle; the filled part takes the slider's Foreground -->
        <Style x:Key="TrackPartStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- Transparent around the line so it's easy to click -->
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A modern slider: a thin line that fills as it goes, with a dot that shows on hover -->
        <Style x:Key="ThinSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="14" Background="Transparent">
                            <!-- The whole line, under the filled part and the (hidden) dot, so it never shows a gap -->
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                    Background="{DynamicResource MutedTextBrush}" Opacity="0.35"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Filled" Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource TrackPartStyle}"
                                                  Background="{TemplateBinding Foreground}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource TrackPartStyle}"
                                                  Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Dot" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="11" Height="11" Fill="{DynamicResource TextBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="Filled" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <!-- The album cover faintly fills the card, like a launcher's mini player -->
            <Border x:Name="Backdrop" CornerRadius="10" Opacity="0.22"/>

            <StackPanel Margin="12,12,12,8">
                <!-- Song: click to open the Music page -->
                <Grid Background="Transparent" Cursor="Hand" ToolTip="Open Music"
                      MouseLeftButtonUp="Info_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                        <Border CornerRadius="6" Background="{DynamicResource SelectedBrush}"/>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="Cover" CornerRadius="6"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailsText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Seek bar: a thin line between the two times -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="6,0" Minimum="0" Maximum="1"
                            Style="{StaticResource ThinSliderStyle}" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Volume: opens a small volume bar above it; the mouse wheel works on it too -->
                    <Button x:Name="VolumeButton" HorizontalAlignment="Left" Content="&#xE767;" ToolTip="Volume"
                            Style="{StaticResource MiniButtonStyle}" Width="28" Height="28" FontSize="12" Margin="0"
                            Click="Volume_Click" MouseWheel="Volume_MouseWheel"/>
                    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}"
                           Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Closed="VolumePopup_Closed">
                        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" MouseWheel="Volume_MouseWheel" Background="Transparent">
                                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100"
                                        Style="{StaticResource ThinSliderStyle}" VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="VolumeText" Width="26" Margin="8,0,0,0" FontSize="11"
                                           TextAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Favourite the song playing now; greyed out for a song that isn't in the playlist -->
                    <Button x:Name="FavouriteButton" Grid.Column="2" HorizontalAlignment="Right" Content="&#xE006;"
                            ToolTip="Add to favourites" Width="28" Height="28" FontSize="12" Margin="0"
                            Click="Favourite_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MiniButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE892;" ToolTip="Previous" Style="{StaticResource MiniButtonStyle}" Click="Previous_Click"/>
                        <Button x:Name="PlayPauseButton" Content="&#xE769;" ToolTip="Pause"
                                Style="{StaticResource MiniButtonStyle}" Width="40" Height="40" FontSize="17"
                                Click="PlayPause_Click"/>
                        <Button Content="&#xE893;" ToolTip="Next" Style="{StaticResource MiniButtonStyle}" Click="Next_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
