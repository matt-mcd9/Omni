<UserControl x:Class="Omni.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Games" Foreground="{StaticResource TextBrush}"
               FontSize="26" FontWeight="Bold"/>

        <Button Width="100"
            Height="50"
            HorizontalAlignment="Left"
            Click="selectGameFolder_Click"
        >Select Folder</Button>

        <ListBox Background="Black"
             Foreground="White"
             MouseDoubleClick="launchGame_MouseDoubleClick"
             x:Name="listGames"
             Width="400"
             Height="300"/>

    </StackPanel>
</UserControl>
