<UserControl x:Class="Omni.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Clickable card surface used by the library tiles and media cards -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined text button (Resume, Add ... in the get-started card) -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,28,0,12"/>
        </Style>

        <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Media card: square icon thumbnail + title + category -->
        <DataTemplate x:Key="MediaCardTemplate">
            <Button Style="{StaticResource CardButtonStyle}" Width="150" Margin="0,0,12,12"
                    Padding="10" Tag="{Binding}" Click="MediaCard_Click" ToolTip="{Binding Title}">
                <StackPanel>
                    <Border Height="110" CornerRadius="6" Background="{DynamicResource HoverBrush}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconStyle}" FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,24">

            <!-- ===== Greeting ===== -->
            <TextBlock x:Name="GreetingText" Text="Welcome back" Foreground="{DynamicResource TextBrush}"
                       FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="DateText" Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13" Margin="0,4,0,20"/>

            <!-- ===== Continue: the last opened item ===== -->
            <Border x:Name="ContinueCard" Visibility="Collapsed"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="160" Height="90" CornerRadius="8" Background="{DynamicResource HoverBrush}">
                        <TextBlock x:Name="ContinueGlyph" Style="{StaticResource IconStyle}" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="Continue" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="ContinueTitle" Foreground="{DynamicResource TextBrush}"
                                   FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ContinueSubtitle" Foreground="{DynamicResource MutedTextBrush}" FontSize="13"/>
                    </StackPanel>
                    <Button x:Name="ContinueButton" Grid.Column="2" Content="Resume" VerticalAlignment="Center"
                            Style="{StaticResource OutlineButtonStyle}" Click="MediaCard_Click"/>
                </Grid>
            </Border>

            <!-- ===== Get started: shown instead of Continue when nothing has been opened ===== -->
            <Border x:Name="GetStartedCard"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Build your library" Foreground="{DynamicResource TextBrush}"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Add a folder of music, videos, games or apps and they'll show up here."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <WrapPanel>
                        <Button Content="Add music" Tag="Music" Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Click="Navigate_Click"/>
                        <Button Content="Add videos" Tag="Videos" Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Click="Navigate_Click"/>
                        <Button Content="Add games" Tag="Games" Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Click="Navigate_Click"/>
                        <Button Content="Add apps" Tag="Software" Style="{StaticResource OutlineButtonStyle}"
                                Click="Navigate_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Library shortcuts ===== -->
            <TextBlock Text="Your library" Style="{StaticResource SectionHeaderStyle}"/>
            <UniformGrid Columns="4">
                <Button Style="{StaticResource CardButtonStyle}" Padding="14" Margin="0,0,12,0"
                        Tag="Music" Click="Navigate_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE8D6;" Style="{StaticResource IconStyle}" FontSize="20"/>
                        <TextBlock x:Name="MusicCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Songs" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButtonStyle}" Padding="14" Margin="0,0,12,0"
                        Tag="Videos" Click="Navigate_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE714;" Style="{StaticResource IconStyle}" FontSize="20"/>
                        <TextBlock x:Name="VideoCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Videos" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButtonStyle}" Padding="14" Margin="0,0,12,0"
                        Tag="Games" Click="Navigate_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource IconStyle}" FontSize="20"/>
                        <TextBlock x:Name="GameCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Games" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButtonStyle}" Padding="14"
                        Tag="Software" Click="Navigate_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource IconStyle}" FontSize="20"/>
                        <TextBlock x:Name="SoftwareCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Apps" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ===== Recently opened ===== -->
            <TextBlock Text="Recently opened" Style="{StaticResource SectionHeaderStyle}"/>
            <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource MediaCardTemplate}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>
            <TextBlock x:Name="RecentEmpty" Text="Things you open will appear here."
                       Style="{StaticResource EmptyTextStyle}"/>

            <!-- ===== Favourites ===== -->
            <TextBlock Text="Favourites" Style="{StaticResource SectionHeaderStyle}"/>
            <ItemsControl x:Name="FavouritesList" ItemTemplate="{StaticResource MediaCardTemplate}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>
            <TextBlock x:Name="FavouritesEmpty" Text="Mark something as a favourite to keep it here."
                       Style="{StaticResource EmptyTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
