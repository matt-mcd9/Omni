<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Omni.Pages.MusicPage" Width="1068">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Music"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>


        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="1280"
                  Height="720">
                <Image Name="AlbumArt" HorizontalAlignment="Left" Height="430" Margin="336,87,0,0" VerticalAlignment="Top" Width="595" Stretch="UniformToFill"/>

            </Grid>
        </Viewbox>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" Width="276" Margin="0,487,0,0" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <Button Width="80"
                    Margin="5"
                    Content="Open"
                    Click="Open_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Play/Pause"
                    Click="Pause_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Stop"
                    Click="Stop_Click"/>

        </StackPanel>

        <ProgressBar Height="10" Width="500" Margin="264,454,264,114" Grid.Row="1"/>


    </Grid>

</UserControl>
