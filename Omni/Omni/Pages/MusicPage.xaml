<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av"
    x:Class="Omni.Pages.MusicPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Music"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Album Art -->
        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="1280"
                  Height="526">

                <Image x:Name="AlbumArt"
                       Width="404"
                       Height="430"
                       Source="/Pictures/album.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,492,0,0">

                    <Button Width="80"
            Margin="5"
            Content="Open"
            Click="Open_Click"/>

                    <Button Width="80"
            Margin="5"
            Content="Play/Pause"
            Click="Play_Click"/>



                    <Button Width="80"
            Margin="5"
            Content="Stop"
            Click="Stop_Click"/>

                </StackPanel>

            </Grid>

        </Viewbox>

        <!-- Music Controls -->
        <Grid Grid.Row="2"
              Margin="0,10,0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Current Time -->
            <TextBlock x:Name="CurrentTimeText"
                       Grid.Column="0"
                       Text="0:00"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <!-- Seek Bar -->
            <Slider x:Name="SeekBar"
                    Grid.Column="2"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

            <!-- Total Time -->
            <TextBlock x:Name="TotalTimeText"
                       Grid.Column="4"
                       Text="0:00"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <!-- Low Volume -->
            <Image Grid.Column="6"
                   Source="/Pictures/soundlow.png"
                   Width="24"
                   Height="24"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="5,0"/>

            <!-- Volume Slider -->
            <Slider Grid.Column="7"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    ValueChanged="VolumeSet"
                    IsMoveToPointEnabled="True"
                    VerticalAlignment="Center"
                    TickPlacement="TopLeft"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"/>

            <!-- High Volume -->
            <Image Grid.Column="8"
                   Source="/Pictures/sound.png"
                   Width="24"
                   Height="24"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="5,0"/>

        </Grid>
    </Grid>

</UserControl>
