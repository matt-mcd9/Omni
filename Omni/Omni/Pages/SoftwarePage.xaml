<UserControl x:Class="Omni.Pages.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Software" Foreground="{DynamicResource TextBrush}"
                   FontSize="26" FontWeight="Bold"/>
        
        <TextBox x:Name="searchBox"
                 Width="400" Height="28" HorizontalAlignment="Left" Margin="0,8,0,8"
                 Background="{DynamicResource SidebarBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 TextChanged="searchBox_TextChanged"/>
        
        <Button Width="100"
                Height="50"
                HorizontalAlignment="Left"
                Click="selectFolder_Click"
            >Select Folder</Button>

        <ListBox Background="{DynamicResource SidebarBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 MouseDoubleClick="launchApp_MouseDoubleClick"
                 x:Name="listApplications"
                 Width="400"
                 Height="300"/>

    </StackPanel>
</UserControl>
