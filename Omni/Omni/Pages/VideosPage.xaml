<UserControl x:Class="Omni.Pages.VideosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Unloaded="VideosPage_Unloaded">
    <UserControl.Resources>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Round icon button for the player controls; Content is a glyph -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined button with an icon + text (Choose folder, Open file) -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless small button with an icon + text (Remove all) -->
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the scanned video list -->
        <Style x:Key="VideoItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Videos" Foreground="{DynamicResource TextBrush}"
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Library: videos scanned from a folder ===== -->
            <Border Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="Library" Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource OutlineButtonStyle}"
                                Click="Open_Click" ToolTip="Play a video file and add it to the library">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IconStyle}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Open file" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Full width under the header, like Add songs on the Music page -->
                    <Button DockPanel.Dock="Top" Margin="2,0,0,8" Height="29"
                            Style="{StaticResource OutlineButtonStyle}" Click="ChooseFolder_Click"
                            ToolTip="Scan a folder for videos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconStyle}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Choose folder" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="FolderText" DockPanel.Dock="Top" Margin="2,0,0,2"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Button x:Name="RemoveAllButton" Grid.Column="1" Style="{StaticResource TextButtonStyle}"
                                Click="RemoveAll_Click" Visibility="Collapsed"
                                ToolTip="Remove every video from the library (the files stay on your computer)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconStyle}" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Remove all" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid>
                        <ListBox x:Name="VideoList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource VideoItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="VideoList_SelectionChanged"
                                 KeyDown="VideoList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE714;" Style="{StaticResource IconStyle}" FontSize="16"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <!-- Shown only while the pointer is over the row -->
                                        <Button Grid.Column="2" Content="&#xE711;" ToolTip="Remove from library"
                                                Width="24" Height="24" FontSize="10" Margin="4,0,0,0"
                                                Click="RemoveVideo_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyText" Margin="2,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
                                   Text="Choose a folder to find the videos in it (MP4, MKV, AVI, MOV and more)."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Player ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video fills the available space; VLC letterboxes to keep the aspect ratio -->
                <Grid Background="Black">
                    <Image x:Name="placeholder" Source="/Pictures/ColorBars.png" Stretch="Uniform"/>
                    <vlc:VideoView x:Name="videoView" Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="NowPlayingText" Grid.Row="1" Text="Nothing playing" Margin="2,12,0,0"
                           Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Seek bar -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" Width="52" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Width="52" FontSize="12"
                               TextAlignment="Right"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controls -->
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Favourite the video playing now; greyed out while nothing from the library is playing -->
                    <Button x:Name="FavouriteButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Content="&#xE006;" ToolTip="Add to favourites" IsEnabled="False" Click="Favourite_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE892;" ToolTip="Previous" Style="{StaticResource PlayerButtonStyle}" Click="Previous_Click"/>
                        <Button x:Name="PlayPauseButton" Content="&#xE768;" ToolTip="Play"
                                Style="{StaticResource PlayerButtonStyle}" FontSize="20" Width="48" Height="48"
                                Click="PlayPause_Click"/>
                        <Button Content="&#xE71A;" ToolTip="Stop" Style="{StaticResource PlayerButtonStyle}" Click="Stop_Click"/>
                        <Button Content="&#xE893;" ToolTip="Next" Style="{StaticResource PlayerButtonStyle}" Click="Next_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE767;" Style="{StaticResource IconStyle}" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="100"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                ValueChanged="VolumeSet"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
