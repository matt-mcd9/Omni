<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av"
    x:Class="Omni.Pages.VideosPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="Videos"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>


        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="1280"
                  Height="720">

                <Image x:Name="placeholder"
                       Source="/Pictures/ColorBars.png" Stretch="Fill"/>

                <vlc:VideoView x:Name="videoView"
                               Visibility="Collapsed"/>

            </Grid>

        </Viewbox>

        <Grid Grid.Row="2"
              Margin="0,10,0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock x:Name="CurrentTimeText"
                       Grid.Column="0"
                       Text="0:00"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Slider x:Name="SeekBar"
                    Grid.Column="2"
                    Minimum="0"
                    Maximum="100"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>

            <TextBlock x:Name="TotalTimeText"
                       Grid.Column="4"
                       Text="0:00"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Image Grid.Column="6"
                   Source="/Pictures/soundlow.png"
                   Width="24"
                   Height="24"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="5,0"/>


            <Slider Grid.Column="7"
                    Minimum="0"
                    Maximum="100"
                    ValueChanged="VolumeSet"
                    IsMoveToPointEnabled="True"
                    VerticalAlignment="Center" TickPlacement="TopLeft" TickFrequency="10" IsSnapToTickEnabled="True" LargeChange="0" SmallChange="4"/>

            <Image Grid.Column="8"
                   Source="/Pictures/sound.png"
                   Width="24"
                   Height="24"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="5,0"/>

        </Grid>


        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0">

            <Button Width="80"
                    Margin="5"
                    Content="Open"
                    Click="Open_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Play"
                    Click="Play_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Pause"
                    Click="Pause_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Stop"
                    Click="Stop_Click"/>

        </StackPanel>

    </Grid>

</UserControl>