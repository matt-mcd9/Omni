<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Omni.Pages.VideosPage" Width="1068">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29.417"/>
            <RowDefinition Height="30.583"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Videos"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>


        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="1280"
                  Height="720">
                <Image x:Name="placeholder"  Source="ColorBars.png"/>
                <vlc:VideoView x:Name="videoView" Visibility="Collapsed"/>

            </Grid>
        </Viewbox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" Width="366" Margin="0,15,0,0" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <Button Width="80"
                    Margin="5"
                    Content="Open"
                    Click="Open_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Play"
                    Click="Play_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Pause"
                    Click="Pause_Click"/>

            <Button Width="80"
                    Margin="5"
                    Content="Stop"
                    Click="Stop_Click"/>

        </StackPanel>
        <Slider Width="150" Margin="752,20,126,-9" Grid.Row="2" TickFrequency="10" IsSnapToTickEnabled="True" Maximum="100" Minimum="0" ValueChanged="VolumeSet" Grid.RowSpan="2" />
        <ProgressBar Height="10" Width="500" Margin="264,5,264,14" Grid.Row="2"/>


    </Grid>

</UserControl>